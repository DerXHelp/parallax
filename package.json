{
  "name": "parallax",
  "version": "0.0.0",
  "private": true,
  "description": "Mission control for parallel Claude Code sessions (local server + web UI).",
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.8"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:live": "concurrently -k -n server,web -c red,magenta \"pnpm:dev:server:live\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false --tsconfig src/server/tsconfig.json --exclude \".worktrees/**\" --exclude \".claude/**\" src/server/main.ts --dev --backend=fake --port=4712 --home=.parallax-dev",
    "dev:server:live": "tsx watch --clear-screen=false --tsconfig src/server/tsconfig.json --exclude \".worktrees/**\" --exclude \".claude/**\" src/server/main.ts --dev --backend=sdk --port=4712 --home=.parallax-dev",
    "dev:web": "vite",
    "build": "tsx --tsconfig tsconfig.tools.json scripts/build.ts",
    "build:web": "vite build",
    "build:server": "tsx --tsconfig tsconfig.tools.json scripts/build-server.ts",
    "start": "tsx --tsconfig src/server/tsconfig.json src/server/launcher/main.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "preflight": "tsx --tsconfig tsconfig.tools.json scripts/preflight.ts",
    "record": "tsx --tsconfig tsconfig.tools.json scripts/record.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.56.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "virtua": "^0.53.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
